# Android / Google TV runtime configuration for Pokémon Radical Red.
# Gradle stages this as variants/radicalred/game.toml inside the app's private files
# directory; paths resolve relative to that location. The BIOS and ROM are
# imported by the player on first launch (SHA-1 verified); neither ships in
# the APK.

[game]
name       = "Pokémon Radical Red"
short_name = "radicalred"

[bios]
path = "../../bios/gba_bios.bin"
sha1 = "300c20df6731a33952ded8c436f7f186d25d3492"

[rom]
path = "../../roms/radicalred.gba"
sha1 = "@RADICALRED_SHA1@"

[save]
type = "flash1m"
size = "0x20000"
path = "../../saves/radicalred.sav"

[runtime]
debug_port   = 19902
window_title = "RadicalRedRecomp"
